      "ai",
      "llm",
      "opencode",
      "claude",
      "codex",
      "pi",
      "omp",
      "oh-my-pi",
      "gemini",
      "grok",
      "copilot",
      "crush",
      "cursor",
      "cursor-agent",
      "muse",
      "hermes",
      "openclaw"
    ],
    "allowMultiple": false
  }
}
