{
  "schemaVersion": 1,
  "id": "jinchaofs.agent-switcher",
  "name": "Agent Helm",
  "version": "0.1.0",
  "author": "jinchaofs",
  "license": "MIT",
  "description": "Bar panel to manage coding agents: open any installed agent, pick the default with a dot, install missing ones.",
